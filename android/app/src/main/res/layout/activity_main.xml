<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etDohUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="DoH URL (https://host/dns-query)"
            android:inputType="textUri"
            android:text="https://dns.google/dns-query" />

        <EditText
            android:id="@+id/etDomain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Name Server / Tunnel Domain"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etPubKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Public Key (64 karakter hex)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etSshUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="SSH Username"
            android:inputType="text" />

        <EditText
            android:id="@+id/etSshPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="SSH Password"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/etSshHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="SSH Host (default 127.0.0.1)"
            android:inputType="text"
            android:text="127.0.0.1" />

        <EditText
            android:id="@+id/etSshPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="SSH Port (default 22)"
            android:inputType="number"
            android:text="22" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Connect" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Status: Disconnected" />

    </LinearLayout>
</ScrollView>